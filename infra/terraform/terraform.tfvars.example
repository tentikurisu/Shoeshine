# AWS Configuration
aws_region   = "eu-west-1"
environment  = "production"

# API Security
api_key      = "your-secure-api-key-here"

# Lambda Configuration
lambda_memory             = 2048
lambda_timeout            = 300
lambda_reserved_concurrency = 0

# Bedrock Configuration
# REQUIRED: Configure your Bedrock model ID
# Examples:
#   - anthropic.claude-sonnet-4-20250507
#   - meta.llama3-2-90b-instruct-v1:0
#   - amazon.titan-text-premier-v1:0
bedrock_model_id = ""

# S3 Configuration
# Use existing buckets only (bucket creation disabled in this branch)
# Comma-separated list of allowed buckets for document retrieval
allowed_s3_buckets = ""

# ECR Image Tag
ecr_image_tag = "latest"
