# Shoeshine Local-Only Environment Variables
# Copy this file to .env and modify as needed

# Server Configuration
SHOESHINE_HOST=0.0.0.0
SHOESHINE_PORT=8000
SHOESHINE_ENV=local

# API Security (optional)
# SHOESHINE_API_KEY=your-secret-api-key
# SHOESHINE_ADMIN_API_KEY=your-admin-api-key

# LLM Configuration
SHOESHINE_OLLAMA_URL=http://localhost:11434
SHOESHINE_LLM_MODEL=llama3

# OCR Configuration
SHOESHINE_DEFAULT_OCR_ENGINE=easyocr
SHOESHINE_OCR_IDLE_TIMEOUT=600

# Performance (optional)
# SHOESHINE_MAX_FILE_SIZE=10
# SHOESHINE_LOG_LEVEL=info
