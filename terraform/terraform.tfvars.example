# AWS Configuration
aws_region   = "eu-west-1"
environment  = "production"

# API Security
api_key      = "your-secure-api-key-here"

# Lambda Configuration
lambda_memory             = 2048
lambda_timeout            = 300
lambda_reserved_concurrency = 0

# Bedrock Configuration
enable_bedrock = true
bedrock_model_id = "anthropic.claude-sonnet-4-20250507"

# Optional S3 Bucket
# Leave empty to skip bucket creation, or provide existing bucket name
# If providing new bucket name, Terraform will create it
# Can also use ARN format: arn:aws:s3:::my-bucket-name
s3_bucket = ""

# ECR Image Tag
ecr_image_tag = "latest"
