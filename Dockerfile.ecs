# Shoeshine ECS/Fargate Container - Full OCR Support
# For AWS ECS deployment with all OCR engines
# Includes: Textract, EasyOCR, Docling, Tesseract

FROM python:3.11-slim

LABEL maintainer="shoeshine"
LABEL description="Document scanning service for AWS ECS with full OCR"
LABEL version="1.0.0"

# Install system dependencies for OpenCV and Tesseract
RUN apt-get update && apt-get install -y \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    libglib2.0-0 \
    libgl1-mesa-glx \
    tesseract-ocr \
    tesseract-ocr-eng \
    poppler-utils \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy requirements (full with docling)
COPY requirements.txt ./

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Pre-download EasyOCR models to reduce cold starts
RUN python -c "import easyocr; easyocr.Reader(['en'], download=True, gpu=False)"

# Copy application code
COPY api_server.py ./
COPY src/ ./src/
COPY config.yaml ./

# Create directories
RUN mkdir -p /tmp/data/raw /tmp/data/index /tmp/data/out

# Set environment
ENV PYTHONUNBUFFERED=1
ENV SHOESHINE_ENV=ecs
ENV SHOESHINE_DEPLOY_MODE=ecs

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8000/health')" || exit 1

# Run the application
EXPOSE 8000

# For ECS, use a proper process manager or gunicorn
CMD ["python", "api_server.py"]
