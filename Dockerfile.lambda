# Shoeshine Lambda Container - Document Scanning API
# For AWS Lambda deployment with FastAPI + Mangum

FROM public.ecr.aws/lambda/python:3.11

LABEL maintainer="shoeshine"
LABEL description="Document scanning service for AWS Lambda"
LABEL version="1.0.0"

# Install system dependencies for OpenCV and OCR
RUN yum update -y && yum install -y \
    libSM6 \
    libXext6 \
    libXrender-dev \
    libgomp1 \
    libglib2.0-0 \
    libgl1-mesa-glx \
    && yum clean all

WORKDIR /var/task

# Copy requirements
COPY requirements.txt ./

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Pre-download EasyOCR models to reduce cold starts
RUN python -c "import easyocr; easyocr.Reader(['en'], download=True, gpu=False)"

# Copy application code
COPY api_server.py ./
COPY shoeshine_lib.py ./
COPY src/ ./src/
COPY config.yaml ./

# Create directories
RUN mkdir -p /tmp/data/raw /tmp/data/index /tmp/data/out

# Set Lambda handler
ENV PYTHONUNBUFFERED=1
ENV SHOESHINE_ENV=lambda

# Lambda expects handler in format: file.function
CMD ["api_server.lambda_handler"]
