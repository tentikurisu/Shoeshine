# Shoeshine Lambda Container - Document Scanning API
# For AWS Lambda deployment with FastAPI + Mangum
# Note: Docling and Tesseract excluded due to Lambda size constraints

FROM public.ecr.aws/lambda/python:3.11

LABEL maintainer="shoeshine"
LABEL description="Document scanning service for AWS Lambda"
LABEL version="1.0.0"

# Install system dependencies for OpenCV and OCR
RUN yum update -y && yum install -y \
    libSM6 \
    libXext6 \
    libXrender-dev \
    libgomp1 \
    libglib2.0-0 \
    libgl1-mesa-glx \
    && yum clean all

WORKDIR /var/task

# Copy requirements (excluding docling for Lambda)
COPY requirements.txt ./

# Install Python dependencies (docling removed for Lambda size)
RUN pip install --no-cache-dir -r requirements.txt || \
    pip install --no-cache-dir \
    pymupdf>=1.24.0 \
    opencv-python>=4.10.0.0 \
    numpy>=2.0.0 \
    pillow>=10.0.0 \
    paddleocr>=2.7.0 \
    pydantic>=2.8.0 \
    PyYAML>=6.0.0 \
    requests>=2.32.0 \
    tqdm>=4.66.0 \
    easyocr>=1.7.0 \
    pytesseract>=0.3.10 \
    fastapi>=0.109.0 \
    uvicorn[standard]>=0.27.0 \
    python-multipart>=0.0.6 \
    boto3>=1.34.0 \
    botocore>=1.34.0 \
    mangum>=0.17.0 \
    pytest>=7.4.0 \
    pytest-asyncio>=0.23.0 \
    httpx>=0.26.0

# Pre-download EasyOCR models to reduce cold starts
RUN python -c "import easyocr; easyocr.Reader(['en'], download=True, gpu=False)" || true

# Copy application code
COPY api_server.py ./
COPY src/ ./src/
COPY config.yaml ./

# Create directories
RUN mkdir -p /tmp/data/raw /tmp/data/index /tmp/data/out

# Set Lambda handler
ENV PYTHONUNBUFFERED=1
ENV SHOESHINE_ENV=lambda
ENV AWS_LAMBDA_FUNCTION_NAME=shoeshine-lambda

# Lambda expects handler in format: file.function
CMD ["api_server.lambda_handler"]
